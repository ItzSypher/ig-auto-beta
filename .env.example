# Copie para .env.local (dev) e cadastre os mesmos valores na Vercel.
# Nada aqui pode ir para o Git: .env.local já está no .gitignore.

# --- Supabase -------------------------------------------------
# Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# A "service_role". NUNCA prefixe com NEXT_PUBLIC_ — ela passa por cima da RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / Instagram ----------------------------------------
# developers.facebook.com > seu app > Configurações > Básico
IG_APP_ID=
IG_APP_SECRET=
# Você inventa esta string. A Meta devolve ela no handshake GET do webhook.
IG_VERIFY_TOKEN=
# Token de longa duração da conta profissional
IG_ACCESS_TOKEN=

# --- Motor de tempo ------------------------------------------
# Você inventa. Protege /api/cron/* contra chamada de fora.
CRON_SECRET=
