# Copie para .env.local (dev) e cadastre os mesmos valores na Vercel.
# Nada aqui pode ir para o Git: .env.local já está no .gitignore.

# --- Supabase -------------------------------------------------
# Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://zxzhyzubeyqddnlsepgs.supabase.co
# A "secret key" (sb_secret_...). NUNCA prefixe com NEXT_PUBLIC_:
# ela passa por cima da RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Instagram ------------------------------------------------
# ATENÇÃO: são as credenciais do APP DO INSTAGRAM, não as do app do Facebook.
# developers.facebook.com > VEMDM > API do Instagram >
#   "Configuração da API com login do Instagram"
IG_APP_ID=1029240283235566
# "Chave secreta do app do Instagram" — é ela que assina o X-Hub-Signature-256
IG_APP_SECRET=

# Você inventa esta string. A Meta devolve ela no handshake GET do webhook.
IG_VERIFY_TOKEN=

# Token de longa duração da conta profissional.
# Sai do passo 2 "Gerar tokens de acesso", depois de adicionar a conta.
IG_ACCESS_TOKEN=

# --- Motor de tempo ------------------------------------------
# Você inventa. Protege /api/cron/* contra chamada de fora.
CRON_SECRET=
