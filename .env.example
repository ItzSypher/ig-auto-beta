# Copie para .env.local (dev) e cadastre os mesmos valores na Vercel.
# Nada aqui pode ir para o Git: .env.local já está no .gitignore.

# --- Supabase -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://zxzhyzubeyqddnlsepgs.supabase.co
# A "secret key" (sb_secret_...). NUNCA prefixe com NEXT_PUBLIC_:
# ela passa por cima da RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta (app do FACEBOOK) -----------------------------------
# Usamos o caminho "Instagram API com login do Facebook", porque a página de
# autorização do login do Instagram responde HTTP 500 (falha da Meta).
# developers.facebook.com > VEMDM > Configurações do app > Básico
FB_APP_ID=1940906499937214
FB_APP_SECRET=

# Você inventa. A Meta devolve no handshake GET do webhook.
IG_VERIFY_TOKEN=

# --- Operação -------------------------------------------------
# Você inventa. Protege /api/cron/* e a tela /conectar.
CRON_SECRET=

# --- Opcionais ------------------------------------------------
# O token de Página e o ID da conta ficam na tabela config, gravados
# por /conectar. Estas duas só existem como reserva manual.
# IG_ACCESS_TOKEN=
# IG_USER_ID=

# Chave do app do INSTAGRAM. Só continua aceita na validação do webhook
# enquanto a migração não fecha; pode sair depois.
# IG_APP_SECRET=
